{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/frontend/browser",
  "devCommand": "ng serve",
  "installCommand": "npm install --legacy-peer-deps",
  "routes": [
    { "src": "/.*\\.(js|css|png|jpg|jpeg|svg|ico|woff|woff2|ttf|eot)", "dest": "/$0", "headers": { "Content-Type": "application/javascript" } },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}